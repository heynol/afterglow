<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name" translatable="false">Afterglow</string>
    <string name="accessibility_service_label">Afterglow music visualizer</string>
    <string name="accessibility_service_description">Notices when an app you enabled (YouTube by default) plays music and shows a visualizer on top. It only reads which app is in front and whether you are using the remote there. No screen content is read, and keys are never intercepted.</string>
    <string name="capture_channel">Audio capture</string>
    <string name="capture_notification">Listening to playback for the visualizer</string>

    <string name="main_subtitle">Music visualizations over YouTube. When music plays, a live preview appears in the corner. Press OK while it is highlighted to go full screen.</string>
    <string name="main_version">Version %1$s</string>
    <string name="setting_enabled">Visualizer on</string>

    <string name="section_setup">Setup</string>
    <string name="setup_accessibility">Accessibility service</string>
    <string name="setup_accessibility_body">Required. Turn on \"Afterglow music visualizer\" under Accessibility. On sideloaded apps, choose \"Allow restricted settings\" in App info first.</string>
    <string name="setup_permission">Audio access</string>
    <string name="setup_permission_body">Required to analyse what is playing. Nothing is recorded or stored.</string>
    <string name="setup_capture">System audio capture</string>
    <string name="setup_capture_body">Only needed if the Visualizer effect hears nothing on this TV. Android shows a recording icon while it is in use, so Afterglow only holds it during a session. To skip the confirmation, run once: adb shell appops set dev.heynol.afterglow PROJECT_MEDIA allow</string>
    <string name="setup_song_info">Song info</string>
    <string name="setup_song_info_body">Optional. Shows title and artist and makes music detection more reliable. If this TV hides the setting: adb shell cmd notification allow_listener dev.heynol.afterglow/dev.heynol.afterglow.service.MediaListenerService</string>
    <string name="setup_test">Try the overlay</string>
    <string name="setup_test_body">Shows the preview over this screen with a demo track. OK = full screen, ◀ ▶ = switch, ▼ = all visuals, ▲ = minimise.</string>

    <string name="section_visuals">Visualizations</string>
    <string name="visuals_manage">All visualizations</string>
    <string name="visuals_manage_body">Preview each one, set colours and knobs, or remove it from the rotation.</string>
    <string name="visuals_count">%1$d of %2$d on</string>

    <string name="section_preview">Corner preview</string>
    <string name="setting_corner">Corner</string>
    <string name="setting_corner_body">Top right stays clear of YouTube\'s title and player controls.</string>
    <string name="corner_top_left">Top left</string>
    <string name="corner_top_right">Top right</string>
    <string name="corner_bottom_left">Bottom left</string>
    <string name="corner_bottom_right">Bottom right</string>

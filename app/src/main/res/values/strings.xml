    <string name="size_small">Small</string>
    <string name="size_medium">Medium</string>
    <string name="size_large">Large</string>
    <string name="setting_focus_time">Preview timer</string>
    <string name="setting_focus_time_body">A ring runs down around the highlighted preview; when it\'s gone, the preview hides and comes back with the next song. Off: the preview keeps the remote until you press X, ▼ or Back.</string>
    <string name="setting_refocus">Highlight again on a new song</string>
    <string name="setting_refocus_body">Only while you are not using the remote.</string>
    <string name="setting_passive_hide">Hide preview after</string>
    <string name="setting_passive_hide_body">The preview comes back with the next song.</string>
    <string name="value_seconds">%d s</string>
    <string name="value_auto">Automatic</string>
    <string name="value_off">Off</string>
    <string name="value_never">Never</string>

    <string name="section_fullscreen">Full screen</string>
    <string name="setting_auto_cycle">Switch visuals automatically</string>
    <string name="setting_auto_cycle_body">Cross-fades to the next visualization.</string>
    <string name="cycle_off">Off</string>
    <string name="cycle_track">On every song</string>
    <string name="cycle_1">Every minute</string>
    <string name="cycle_3">Every 3 min</string>
    <string name="cycle_5">Every 5 min</string>
    <string name="setting_shuffle">Random order when switching automatically</string>
    <string name="setting_track_info">Show song title</string>
    <string name="setting_track_info_body">Briefly, when a song starts. Needs song info access.</string>
    <string name="setting_opacity">Opacity</string>
    <string name="setting_opacity_body" formatted="false">Below 100 %, the video shows through.</string>

    <string name="section_detection">Music detection &amp; audio</string>
    <string name="setting_detection">When to show</string>
    <string name="setting_detection_body">Automatic tells music from talk by rhythm, harmony and speech patterns, plus the song info.</string>
    <string name="detection_auto">When music plays</string>
    <string name="detection_any">On any playback</string>
    <string name="setting_audio_source">Audio source</string>
    <string name="setting_audio_source_body">Automatic uses the Visualizer effect, which needs no recording, and only switches to system audio capture if that stays silent. While capture runs, the TV shows a recording icon.</string>
    <string name="source_auto">Automatic</string>
    <string name="source_capture">System audio</string>
    <string name="source_visualizer">Visualizer effect</string>
    <string name="setting_av_delay">Picture delay</string>
    <string name="setting_av_delay_body">Holds visuals back so beats land with the sound from TV or soundbar.</string>
    <string name="setting_sensitivity">Sensitivity</string>

    <string name="section_look">Performance</string>
    <string name="setting_quality">Quality</string>
    <string name="setting_quality_body">Maximum resolution. Heavy visuals lower it on their own to stay smooth.</string>
    <string name="quality_efficient">Efficient · 540p</string>
    <string name="quality_balanced">Balanced · 720p</string>
    <string name="quality_high">High · 1080p</string>
    <string name="setting_fps">Frame rate</string>
    <string name="setting_fps_body">Automatic runs at 60 fps and drops a visual to 30 when it cannot hold that even at its lowest resolution — at 30 fps the GPU has twice the time per frame and renders about twice the pixels.</string>
    <string name="setting_reduce_flashing">Reduce flashing</string>
    <string name="setting_reduce_flashing_body">Softens beat flashes and strobes.</string>

